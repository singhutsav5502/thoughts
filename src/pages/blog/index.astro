---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Archive · Utsav Singh" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head rise">
				<p class="meta">Archive</p>
				<h1>Writing</h1>
				<p>Essays and build notes, newest first.</p>
			</header>
			<ul class="archive">
				{
					posts.map((post) => (
						<li class="rise rise-delay-1">
							<a href={`${base}blog/${post.id}/`}>
								<span class="meta">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="title">{post.data.title}</span>
								<span class="desc">{post.data.description}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		margin-bottom: 2rem;
		max-width: 36rem;
	}

	.page-head h1 {
		font-size: clamp(2.1rem, 8vw, 2.8rem);
	}

	.page-head p {
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.archive {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.archive li {
		border-top: 1px solid var(--line);
	}

	.archive a {
		display: grid;
		gap: 0.4rem;
		padding: 1.45rem 0;
		text-decoration: none;
		color: inherit;
	}

	.archive .title {
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 5vw, 1.5rem);
		font-weight: 600;
		color: var(--ink);
		line-height: 1.3;
	}

	.archive .desc {
		color: #2f3640;
		max-width: 40rem;
		font-size: 1rem;
		line-height: 1.6;
	}

	.archive a:hover .title {
		color: var(--accent-strong);
	}
</style>
