---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags, sourceUrl } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · Utsav Singh`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article class="post rise">
				<header class="post-head">
					<p class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									{' · '}
									Updated <FormattedDate date={updatedDate} />
								</>
							)
						}
					</p>
					<h1>{title}</h1>
					<p class="lede">{description}</p>
					{
						tags.length > 0 && (
							<ul class="tags">
								{tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						)
					}
				</header>
				{
					heroImage && (
						<figure class="hero">
							<img src={heroImage} alt="" width="1200" height="630" />
						</figure>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{
					sourceUrl && (
						<p class="source meta">
							Originally published on{' '}
							<a href={sourceUrl} target="_blank" rel="noopener noreferrer">
								Hashnode
							</a>
						</p>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(100% - 2 * var(--space), 38rem);
		padding-inline: 0;
	}

	.post {
		width: 100%;
		margin-inline: auto;
		overflow-wrap: anywhere;
	}

	.post-head {
		margin-bottom: 2rem;
	}

	.lede {
		font-size: clamp(1.08rem, 3.5vw, 1.18rem);
		line-height: 1.6;
		max-width: 38rem;
		color: #2f3640;
	}

	@media (max-width: 720px) {
		.post-head h1 {
			font-size: clamp(1.85rem, 9vw, 2.4rem);
			line-height: 1.15;
		}

		.prose {
			font-size: 1.05rem;
			line-height: 1.75;
		}
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
	}

	.tags li {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.28rem 0.55rem;
		border: 1px solid var(--line);
		color: var(--ink-soft);
	}

	.hero {
		margin: 0 0 2.25rem;
	}

	.hero img {
		width: 100%;
		display: block;
		border: 1px solid var(--line);
	}

	.source {
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}
</style>
