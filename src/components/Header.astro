---
import PixelCat from './PixelCat.astro';
import PixelClick from './PixelClick.astro';
import { SITE_TITLE, SOCIAL } from '../consts';

const base = import.meta.env.BASE_URL;
---

<PixelCat />
<PixelClick />
<header>
	<nav aria-label="Primary">
		<a class="brand" href={base}>{SITE_TITLE}</a>
		<a class="writing" href={`${base}blog/`}>Writing</a>
		<div class="icons">
			<a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
				<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
					><path
						fill="currentColor"
						d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
					></path></svg
				>
			</a>
			<a href={SOCIAL.twitter} target="_blank" rel="noopener noreferrer" aria-label="X">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
					><path
						fill="currentColor"
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		backdrop-filter: blur(10px);
		background: color-mix(in srgb, var(--paper) 92%, transparent);
		border-bottom: 1px solid var(--line);
	}

	nav {
		width: min(100% - 2 * var(--space), 38rem);
		margin-inline: auto;
		display: flex;
		align-items: center;
		gap: 0.25rem 0.65rem;
		padding-block: 0.65rem;
		min-height: 3.25rem;
	}

	.brand {
		font-family: var(--font-display);
		font-size: 1.08rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-decoration: none;
		margin-right: auto;
		min-width: 0;
		padding: 0.35rem 0;
	}

	.brand:hover {
		color: var(--accent-strong);
	}

	.writing {
		padding: 0.55rem 0.55rem;
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		position: relative;
	}

	.writing::after {
		content: '';
		position: absolute;
		left: 0.55rem;
		right: 0.55rem;
		bottom: 0.3rem;
		height: 1.5px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 200ms ease;
	}

	.writing:hover {
		color: var(--ink);
	}

	.writing:hover::after {
		transform: scaleX(1);
	}

	.icons {
		display: flex;
		align-items: center;
		gap: 0.05rem;
	}

	.icons a {
		display: grid;
		place-items: center;
		width: 2.65rem;
		height: 2.65rem;
		color: var(--ink-soft);
		text-decoration: none;
	}

	.icons a:hover {
		color: var(--ink);
	}

	@media (max-width: 480px) {
		.brand {
			font-size: 1rem;
		}

		.writing {
			font-size: 0.92rem;
			padding-inline: 0.4rem;
		}

		.icons a {
			width: 2.5rem;
			height: 2.5rem;
		}
	}
</style>
